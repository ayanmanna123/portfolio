{
  "rewrites": [
    {
      "source": "/leetcode-proxy/(.*)",
      "destination": "https://leetcode.com/$1"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/((?!admin|api|uploads|certificates|projects|testimonials|assets|logo.svg|robots.txt|sitemap.xml).*)",
      "destination": "/index.html"
    }
  ]
}